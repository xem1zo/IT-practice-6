2026-11-17T14:00:13.000000Z	   10 Query	SELECT c.client_name, SUM(p.unit_price * si.quantity) AS total_spent FROM sales s JOIN clients c ON s.client_id = c.client_id JOIN sale_items si ON s.sale_id = si.sale_id JOIN products p ON si.product_id = p.product_id WHERE c.client_name = 'Иванов Иван' GROUP BY c.client_name
